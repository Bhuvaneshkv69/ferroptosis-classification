.venv/
__pycache__/
.pytest_cache/
*.pyc
.ipynb_checkpoints/

# Large, regenerable model binaries (run scripts/train_and_persist.py to
# recreate them). The registry metadata (models/registry.json) IS tracked.
models/**/*.joblib

# Large, regenerable raw downloads (documented in docs/DATASET.md with the
# exact fetch script/URL to recreate them). Small derived metadata/gene-list
# files from the same fetches ARE tracked.
data/raw/gdsc/GDSC2_public_raw_data_24Jul22.csv
data/raw/tcga/whole_transcriptome_expression_long.csv

# Runtime output of the application itself -- regenerated by using the
# workspace (analysis history log, exported HTML reports). Not source.
results/analysis_sessions.json
results/reports/*.html


# Model-selection benchmark: nested-CV cache (regenerable) and runtime artifacts
results/benchmark/cache/
results/benchmark/*.log
results/benchmark/benchmark_summary_quick.json
results/benchmark/regression_summary_quick.json
data/processed/uploaded_training_table.csv
browser_check/
data/processed/tcga_whole_transcriptome_log2.pkl
